{
  "[cpp]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "always"
    }
  },
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "chat.agent.enabled": false,
  "chat.disableAIFeatures": true,
  "clangd.path": "/opt/homebrew/opt/llvm/bin/clangd",
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.detectIndentation": true,
  "editor.experimental.asyncTokenization": true,
  "editor.foldingHighlight": false,
  "editor.fontFamily": "Iosevka",
  "editor.fontSize": 13,
  "editor.fontLigatures": true,
  "editor.fontWeight": "500",
  "editor.hideCursorInOverviewRuler": true,
  "editor.indentSize": "tabSize",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlineSuggest.enabled": false,
  "editor.lineHeight": 16,
  "editor.lineNumbers": "relative",
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.renderLineHighlight": "gutter",
  "editor.renderWhitespace": "none",
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "rules": { "concept": "#4EC9B0" }
    },
    "[Light Modern]": {
      "rules": { "concept": "#267F99" }
    }
  },
  "editor.smoothScrolling": true,
  "editor.tabSize": 4,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 1,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.hip": "cpp"
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.git/**": true,
  },
  "git.blame.statusBarItem.enabled": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "lldb-dap.executable-path": "/opt/homebrew/opt/lldb/bin/lldb-dap",
  "multiDiffEditor.experimental.fileList": true,
  "python.languageServer": "None",
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.completion.autoimport.enable": false,
  "rust-analyzer.inlayHints.maxLength": 32,
  "scm.diffDecorationsGutterVisibility": "hover",
  "telemetry.telemetryLevel": "off",
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.initialHint": false,
  "todo-tree.general.exportPath": "/tmp/todo-tree-%Y%m%d-%H%M.txt|todo!",
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 500,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<C-s>"
      ],
      "commands": [
        "editor.action.triggerParameterHints"
      ]
    }
  ],
  "vim.leader": " ",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        "<leader>",
        "d"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "q"
      ],
      "commands": [
        ":q"
      ]
    },
    {
      "before": [
        "<leader>",
        "w"
      ],
      "commands": [
        ":w"
      ]
    },
    {
      "before": [
        "n"
      ],
      "after": [
        "n",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "N"
      ],
      "after": [
        "N",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "*"
      ],
      "after": [
        "*",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "#"
      ],
      "after": [
        "#",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "g",
        "*"
      ],
      "after": [
        "g",
        "*",
        "z",
        "z"
      ]
    },
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "$"
      ]
    },
    {
      "before": [
        "g",
        "l"
      ],
      "commands": [
        "workbench.action.openPreviousRecentlyUsedEditorInGroup"
      ]
    },
    {
      "before": [
        "t",
        "f"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "t",
        "F"
      ],
      "commands": [
        "workbench.files.action.showActiveFileInExplorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "l"
      ],
      "commands": [
        "workbench.action.showAllEditors"
      ]
    },
    {
      "before": [
        "g",
        "/"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "g",
        "s"
      ],
      "commands": [
        "workbench.action.gotoSymbol"
      ]
    },
    {
      "before": [
        "g",
        "S"
      ],
      "commands": [
        "workbench.action.showAllSymbols"
      ]
    },
    {
      "before": [
        "g",
        "n"
      ],
      "commands": [
        "workbench.action.nextEditor"
      ]
    },
    {
      "before": [
        "g",
        "p"
      ],
      "commands": [
        "workbench.action.previousEditor"
      ]
    },
    {
      "before": [
        "g",
        "N"
      ],
      "commands": [
        "workbench.action.moveEditorRightInGroup"
      ]
    },
    {
      "before": [
        "g",
        "P"
      ],
      "commands": [
        "workbench.action.moveEditorLeftInGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "b",
        "p"
      ],
      "commands": [
        "workbench.action.showEditorsInActiveGroup"
      ]
    },
    {
      "before": [
        "g",
        "["
      ],
      "commands": [
        "editor.action.marker.prev"
      ]
    },
    {
      "before": [
        "g",
        "]"
      ],
      "commands": [
        "editor.action.marker.next"
      ]
    },
    {
      "before": [
        "[",
        "d"
      ],
      "commands": [
        "editor.action.marker.prev"
      ]
    },
    {
      "before": [
        "]",
        "d"
      ],
      "commands": [
        "editor.action.marker.next"
      ]
    },
    {
      "before": [
        "g",
        "D"
      ],
      "commands": [
        "editor.action.revealDeclaration"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.showHover"
      ]
    },
    {
      "before": [
        "g",
        "r",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    {
      "before": [
        "g",
        "r",
        "i"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ]
    },
    {
      "before": [
        "g",
        "r",
        "n"
      ],
      "commands": [
        "editor.action.rename"
      ]
    },
    {
      "before": [
        "g",
        "r",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
    {
      "before": [
        "g",
        "r",
        "t"
      ],
      "commands": [
        "editor.action.goToTypeDefinition"
      ]
    },
    {
      "before": [
        "g",
        "O"
      ],
      "commands": [
        "workbench.action.gotoSymbol"
      ]
    },
    {
      "before": [
        "<C-w>",
        "g",
        "d"
      ],
      "commands": [
        "editor.action.revealDefinitionAside"
      ]
    },
    {
      "before": [
        "g",
        "h"
      ],
      "commands": [
        "clangd.switchheadersource"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "commands": [
        "editor.action.peekDefinition"
      ]
    },
    {
      "before": [
        "<C-W>",
        "H"
      ],
      "commands": [
        "workbench.action.moveEditorToPreviousGroup"
      ]
    },
    {
      "before": [
        "<C-W>",
        "L"
      ],
      "commands": [
        "workbench.action.moveEditorToNextGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "r"
      ],
      "commands": [
        "editor.action.rename"
      ]
    },
    {
      "before": [
        "<leader>",
        "b"
      ],
      "commands": [
        "editor.debug.action.toggleBreakpoint"
      ]
    }
  ],
  "vim.operatorPendingModeKeyBindingsNonRecursive": [
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "$"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "$"
      ]
    },
    {
      "before": [
        "g",
        "r",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    }
  ],
  "vim.smartRelativeLine": true,
  "vim.vimrc.enable": false,
  "window.restoreWindows": "none",
  "window.zoomLevel": -0.25,
  "window.zoomPerWindow": false,
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "editor.background": "#181818",
      "editorInlayHint.background": "#181818",
      "editorInlayHint.foreground": "#a0a0a0"
    },
    "[Light Modern]": {
      "editor.background": "#f8f8f8",
      "editorInlayHint.background": "#f8f8f8",
      "editorInlayHint.foreground": "#707070"
    }
  },
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editor.useModal": "off",
  "workbench.experimental.modernUIEditorTabStyle": "pill",
  "workbench.list.smoothScrolling": true,
  "workbench.panel.defaultLocation": "bottom",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "onHover",
}
